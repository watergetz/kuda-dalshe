вы — мемориал памяти А. И. Герцена и Н. П. Огарёва. Находится на Воробьёвых горах, на месте, где юные Герцен и Огарёв дали клятву посвятить свою жизнь борьбе за свободу. Представляет собой гранитный обелиск, окружённый стеной, в которую вмонтирован свиток с портретным изображением Герцена и Огарёва.","ds":"w"},{"i":"n2617302551","n":"А. Г. Столетову","a":[55.70021,37.5287],"g":"monument","l":"Памятник","b":1.5},{"i":"n2617302552","n":"П. Н. Лебедеву","a":[55.70057,37.52937],"g":"monument","l":"Памятник","b":1.5},{"i":"n2617418618","n":"Скульптура","a":[55.70356,37.53247],"g":"art","l":"Скульптура","b":2},{"i":"n3503130075","n":"Мемориальный кабинет-музей академика А. П. Виноградова","a":[55.70532,37.54965],"g":"culture","l":"Музей","b":2,"h":"Mo-Fr 10:00-18:00","f":"Год открытия — 1975."},{"i":"n3567067250","n":"Лиса","a":[55.70276,37.55629],"g":"art","l":"Арт-объект","b":2},{"i":"n3608780016","n":"Симону Боливару","a":[55.70033,37.54685],"g":"monument","l":"Памятник","b":1.5,"f":"Год установки — 2010."},{"i":"n4836803270","n":"Скульптура","a":[55.70981,37.55163],"g":"art","l":"Скульптура","b":2,"f":"Надпись: «1812 «Самым уступлением Москвы приготовим мы гибель неприятелю. М. И. Голенищев-Кутузов»."},{"i":"n4945809422","n":"Ботанический сад Дворца пионеров","a":[55.70245,37.55402],"g":"attraction","l":"Достопримечательность","b":2.5},{"i":"n5180535131","n":"В. Б. Харламову","a":[55.7191,37.54631],"g":"monument","l":"Памятник","b":1.5},{"i":"n5596776128","n":"Смотровая точка","a":[55.71581,37.54698],"g":"view","l":"Смотровая точка","b":3,"e":1},{"i":"n7213761685","n":"Э. П. Стрельцову","a":[55.71858,37.54479],"g":"monument","l":"Памятник","b":1.5},{"i":"n7213761686","n":"Н. П. Старостину","a":[55.71849,37.54456],"g":"monument","l":"Памятник","b":1.5},{"i":"n7213764186","n":"Л. И. Яшину","a":[55.7184,37.54432],"g":"monument","l":"Памятник","b":1.5},{"i":"n7674019331","n":"Земля","a":[55.7137,37.5497],"g":"art","l":"Скульптура","b":2,"d":"аллегорическая скульптурная ко