[{"i":"n693644274","n":"Усадьба Суханово","a":[55.52595,37.66244],"g":"history","l":"История","b":2,"w":"Суханово (усадьба)","d":"Суханово — дворянская усадьба конца XVIII—XIX веков, которая была превращена в яркий памятник русского классицизма заботами княгини Е. А. Волконской (1770—1853), дочери екатерининского сановника А. П. Мельгунова. Светлейший князь П. М. Волконский объявил Суханово заповедным имением — ядром майората Волконских.","ds":"w"},{"i":"n2423329237","n":"Смотровая точка","a":[55.52395,37.661],"g":"view","l":"Смотровая точка","b":3,"e":1},{"i":"n4364483089","n":"Часовня во имя преподобного Сергия игумена Радонежского.","a":[55.52233,37.65546],"g":"worship","l":"Храм","b":2},{"i":"n4456313893","n":"Героям Великой Отечественной войны","a":[55.52869,37.64721],"g":"monument","l":"Памятник","b":1.5},{"i":"n4456976962","n":"Дева с разбитым кувшином","a":[55.52298,37.66313],"g":"monument","l":"Памятник","b":1.5,"d":"кувшина нет, своровали при СССР"},{"i":"n5225305748","n":"Дом управляющего","a":[55.52409,37.66364],"g":"attraction","l":"Достопримечательность","b":2.5},{"i":"n5225305749","n":"Дом церковнослужителей","a":[55.52454,37.66433],"g":"attraction","l":"Достопримечательность","b":2.5},{"i":"n5225305750","n":"Жилой флигель","a":[55.52503,37.66207],"g":"attraction","l":"Достопримечательность","b":2.5},{"i":"n5225305751","n":"Главный дом","a":[55.5253,37.66151],"g":"attraction","l":"Достопримечательность","b":2.5},{"i":"n5225305752","n":"Кухонный флигель","a":[55.52457,37.66322],"g":"attraction","l":"Достопримечательность","b":2.5},{"i":"n5225307862","n":"Конюшня","a":[55.52571,37.66365],"g":"attraction","l":"Достопримечательность","b":2.5},{"i":"n5225307863","n":"Мавзолей Волконских","a":[55.52229,37.66353],"g":"history","l":"История","b":2},{"i":"n5225309629","n":"Гостевой дом усадьбы","a":[55.52427,37.66399],"g":"attraction","l":"Достопримечательность","b":2.5},{"i":"n6486246503","n":"Фонтан","a":[55.5235,37.64552],"g":"fountain","l":"Фонтан","b":1},