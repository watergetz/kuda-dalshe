[{"i":"n612045717","n":"Московский театр кукол. Камерная сцена","a":[55.83484,37.66127],"g":"culture","l":"Театр","b":2},{"i":"n614438912","n":"Рабочий и колхозница","a":[55.82818,37.64675],"g":"monument","l":"Памятник","b":1.5,"w":"Рабочий и колхозница","d":"«Рабочий и колхозница» — памятник монументального искусства, «идеал и символ советской эпохи», признанный «эталон социалистического реализма». Представляет собой скульптурную группу из двух фигур, мужской и женской, которые устремлены вперёд и поднимают над своими головами серп и молот. Концепция и композиционный замысел принадлежат архитектору Борису Иофану, автор пластического воплощения — Вера Мухина.","ds":"w"},{"i":"n631462876","n":"В. М. Комарову","a":[55.82186,37.64016],"g":"monument","l":"Памятник","b":1.5},{"i":"n631462877","n":"А. А. Леонову","a":[55.82192,37.64019],"g":"monument","l":"Памятник","b":1.5},{"i":"n631462878","n":"П. И. Беляеву","a":[55.82198,37.64021],"g":"monument","l":"Памятник","b":1.5},{"i":"n631462879","n":"Ю. А. Гагарину","a":[55.8221,37.64025],"g":"monument","l":"Памятник","b":1.5},{"i":"n631462880","n":"В. В. Терешковой","a":[55.82204,37.64023],"g":"monument","l":"Памятник","b":1.5,"f":"Надпись: «Летчик-космонавт СССР Валентина Терешкова»."},{"i":"n773364602","n":"Ростокинский дворник","a":[55.83198,37.65887],"g":"art","l":"Скульптура","b":2,"w":"Ростокинский дворник","f":"Год создания — 2006. Автор — Андрей Асерьянц,  Владимир Лепешов.","d":"Ростокинский дворник — одна из достопримечательностей Москвы, установленная в 2006 году на Малахитовой улице в Ростокинском районе.","ds":"w"},{"i":"n887939238","n":"Постскриптум","a":[55.837,37.64168],"g":"culture","l":"Театр","b":2,"w":"Постскриптум (театр)","d":"Театр-студия «Постскриптум» — московский театр-студия, существует с 1974 года. При театре действует студия актёрского мастерства.","ds":"w"},{"i":"n942777858","n":"Скульптура","a":[55.82174,37.66578],"g":"art","l":"Скульптура","b":2},{"i":"n1019315274","n":"Шарль де Голль","a":[55